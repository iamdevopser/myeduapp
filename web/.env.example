# PostgreSQL connection string (Neon, local Postgres, or any Postgres 15+).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/myeduapp?schema=public"

# At least 32 characters. Used to sign the httpOnly session cookie.
SESSION_SECRET="replace-with-a-random-string-of-at-least-32-chars"

# local writes under STORAGE_DIR. Switch the adapter later without changing callers.
STORAGE_DRIVER="local"
STORAGE_DIR="./storage"

# Optional first admin, applied by `npm run db:seed` only when no admin exists.
BOOTSTRAP_ADMIN_USERNAME=""
BOOTSTRAP_ADMIN_PASSWORD=""
BOOTSTRAP_ADMIN_NAME="Yönetici"
BOOTSTRAP_ADMIN_EMAIL=""
