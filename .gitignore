# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Scratch logs, local databases, and editor backups.
# Root-only for txt/json so web/manifest.json and asset Contents.json stay tracked.
/*.txt
/*.json
*.bak
*.sqlite
*.restore_backup
*.before_ui
*.before_design
*.before_restore_fix
*.backup
*.backup-*

# Keep project notes local; do not publish markdown to GitHub.
*.md
